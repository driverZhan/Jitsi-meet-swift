platform :ios, '15.0'

target 'JitsiObjCDemo' do
  use_frameworks!

  # LJMeet 以本地 podspec（../LJMeet.podspec）集成：vendored dist/LJMeet.xcframework +
  # dist/LJMeet_LJMeet.bundle，WebRTC 媒体栈由 podspec 的 s.dependency 自动带上。
  pod 'LJMeet', :path => '../'

  # 二进制 LJMeet.xcframework 是对着这个确定的 libwebrtc 构建编译的（见
  # dist/WebRTC-LICENSE.txt），podspec 声明 '~> 155.0'。如需钉死补丁版本防漂移，
  # 取消下一行注释。
  #pod 'JitsiWebRTC', '155.0.1'
end

# trunk 的 JitsiWebRTC 声明 iOS 14；Xcode 27 拒绝构建低于 15 的 target。
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
