platform :ios, '15.0'

target 'JitsiObjCDemo' do
  use_frameworks!

  # The static JitsiMeetSDK.xcframework was compiled against this exact libwebrtc build
  # (see dist/WebRTC-LICENSE.txt). Do not float the version.
  pod 'JitsiWebRTC', '124.0.2'
end

# The pod still declares iOS 12; Xcode 27 refuses to build anything below 15.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
